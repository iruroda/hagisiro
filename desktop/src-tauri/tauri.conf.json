{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hagisiro",
  "version": "2.0.0",
  "identifier": "com.iruroda.hagisiro",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Iruroda",
    "copyright": "Copyright © Iruroda",
    "shortDescription": "Hagisiro 바탕화면 위젯",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "customLanguageFiles": { "Korean": "Korean.nsh" },
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
