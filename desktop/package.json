{
  "name": "hagisiro-widget",
  "productName": "HAGISIRO",
  "version": "1.1.1",
  "description": "HAGISIRO 바탕화면 위젯",
  "main": "main.js",
  "author": "iruroda",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.iruroda.hagisiro",
    "productName": "HAGISIRO",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "HAGISIRO.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HAGISIRO",
      "deleteAppDataOnUninstall": false,
      "artifactName": "HAGISIRO-Setup.exe"
    }
  }
}
